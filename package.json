{
  "name": "patrimoine-os-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Tests automatisés end-to-end (UI + API) de PatrimoineOS avec Playwright",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:5173",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.0",
    "typescript": "^5.7.3"
  }
}
